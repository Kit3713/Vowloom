# Copy to .env and replace both values before starting containers.
POSTGRES_PASSWORD=replace-with-a-long-random-password
RAILS_MASTER_KEY=copy-the-value-from-config/master.key
# Optional alternative to RAILS_MASTER_KEY for hosts that manage Rails secrets
# as environment variables. Use one of the two, never commit either one.
# SECRET_KEY_BASE=generate-with-bin-rails-secret
WEB_PORT=3000
VOWLOOM_HOST=wedding.example.com
# Set true when a reverse proxy terminates HTTPS for the container.
FORCE_SSL=true
ACTIVE_STORAGE_SERVICE=local
# Keep durable email and album-export jobs inside the web container's Solid
# Queue supervisor. One worker process is enough for a single wedding site.
JOB_CONCURRENCY=1
# Email stays disabled until VOWLOOM_SMTP_ADDRESS is set. SMTP is only needed
# for password recovery and intentionally selected important announcements.
VOWLOOM_MAIL_FROM=Vowloom <no-reply@wedding.example.com>
# VOWLOOM_SMTP_ADDRESS=smtp.example.com
# VOWLOOM_SMTP_PORT=587
# VOWLOOM_SMTP_USERNAME=
# VOWLOOM_SMTP_PASSWORD=
# VOWLOOM_SMTP_AUTHENTICATION=plain
# VOWLOOM_SMTP_STARTTLS=true
# To use AWS S3 or a compatible service such as MinIO, set ACTIVE_STORAGE_SERVICE=s3
# and provide S3_ACCESS_KEY_ID, S3_SECRET_ACCESS_KEY, S3_BUCKET, and optionally
# S3_ENDPOINT, S3_REGION, and S3_FORCE_PATH_STYLE=true.
