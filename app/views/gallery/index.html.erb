<main class="community-page" style="--accent: <%= @site.accent_color %>">
  <section class="feed-shell">
    <header class="page-intro"><div><p class="eyebrow">The visual story</p><h1>Gallery</h1><p>Professional portraits, candid moments, and the wedding as everyone saw it.</p></div><span class="storage-note"><strong><%= number_to_human_size(@media_bytes_used) %></strong> used</span></header>

    <% if authenticated? && @site.content_live? %>
      <details class="create-panel"><summary><% if Current.user.profile_photo.attached? %><%= image_tag Current.user.profile_photo, class: "avatar", alt: "" %><% else %><span class="avatar avatar-fallback"><%= person_initials(Current.user) %></span><% end %><span>Add a photo or video</span></summary><%= form_with model: @media_asset, class: "composer" do |f| %>
        <%= f.label :file, "Upload photo or video" %>
        <%= f.file_field :file, required: true, accept: "image/*,video/*" %>
        <%= f.label :caption %>
        <%= f.text_field :caption %>
        <%= f.label :credit %>
        <%= f.text_field :credit %>
        <%= f.submit "Upload", class: "button" %>
      <% end %></details>
    <% end %>

    <% if authenticated? && (Current.user.owner? || Current.user.admin? || Current.user.helper?) && @site.content_live? %>
      <details class="create-panel"><summary><span class="create-icon"><%= social_icon(:plus) %></span><span>Create an album</span></summary><%= form_with model: @album, class: "composer" do |f| %>
        <%= f.label :title, "New album" %>
        <%= f.text_field :title, required: true %>
        <%= f.label :visibility %>
        <%= f.select :visibility, [["Members only", "members_only"], ["Everyone", "everyone"]] %>
        <%= f.submit "Create album", class: "button button-secondary" %>
      <% end %></details>

      <% unless @submitted_assets.empty? %>
        <section class="post-card">
          <h2>Media awaiting review</h2>
          <% @submitted_assets.each do |asset| %>
            <article class="post-card">
              <p><strong><%= asset.user.display_name %></strong> uploaded <%= asset.file.filename %></p>
              <% if asset.image? %>
                <%= image_tag asset.rendition(:thumbnail), class: "review-media" %>
              <% else %>
                <%= video_tag url_for(asset.file), controls: true, class: "review-media" %>
              <% end %>
              <%= form_with model: asset, class: "stack" do |f| %>
                <%= f.label :caption %>
                <%= f.text_field :caption %>
                <%= f.label :credit %>
                <%= f.text_field :credit %>
                <%= label_tag "album_id_#{asset.id}", "Add to album (optional)" %>
                <%= select_tag :album_id, options_from_collection_for_select(@curation_albums, :id, :title), include_blank: "Do not add to an album", id: "album_id_#{asset.id}" %>
                <%= f.check_box :featured %>
                <%= f.label :featured, "Feature in the Gallery" %>
                <div class="actions">
                  <%= f.submit "Approve", name: :moderation_action, value: "approve", class: "button button-secondary" %>
                  <%= f.submit "Hide", name: :moderation_action, value: "hide", class: "text-button" %>
                </div>
              <% end %>
            </article>
          <% end %>
        </section>
      <% end %>
    <% end %>

    <% unless @media_assets.empty? %>
      <section class="media-grid gallery-grid">
        <% @media_assets.each do |asset| %>
          <figure>
            <% if asset.image? %>
              <%= image_tag asset.rendition(:feed) %>
            <% else %>
              <%= video_tag url_for(asset.file), controls: true %>
            <% end %>
            <figcaption>
              <%= asset.caption %> · <%= asset.credit.presence || asset.user.display_name %>
              <% if authenticated? %>
                <br><%= link_to "Download web copy", download_media_asset_path(asset) %>
                <% if Current.user.owner? || Current.user.admin? || Current.user.helper? %>
                  · <%= link_to "Download original", download_media_asset_path(asset, original: 1) %>
                <% end %>
              <% end %>
            </figcaption>
          </figure>
        <% end %>
      </section>
    <% end %>

    <% @albums.each do |album| %>
      <article class="post-card" id="<%= dom_id(album) %>">
        <h2><%= album.title %></h2>
        <%= simple_format(album.description) %>
        <% if authenticated? && album.accessible_to?(Current.user) %>
          <div class="actions">
            <%= button_to "Prepare album download", album_album_exports_path(album), class: "button button-secondary" %>
            <% if Current.user.owner? || Current.user.admin? || Current.user.helper? %>
              <%= button_to "Prepare original-file ZIP", album_album_exports_path(album, include_originals: 1), class: "text-button", form: { data: { turbo_confirm: "This can create a large temporary download containing original files." } } %>
            <% end %>
          </div>
          <% album.album_exports.where(requested_by: Current.user).order(created_at: :desc).limit(3).each do |export| %>
            <p class="muted">
              <% if export.ready? && !export.expired? %>
                <%= link_to "Download #{export.include_originals? ? 'original-file' : 'web-sized'} ZIP (#{export.media_count} files)", download_album_album_export_path(album, export) %>
                · available until <%= l(export.expires_at, format: :short) %>
              <% elsif export.failed? %>
                <%= export.error_message %>
              <% else %>
                Preparing <%= export.include_originals? ? "original-file" : "web-sized" %> ZIP…
              <% end %>
            </p>
          <% end %>
        <% end %>
        <section class="media-grid">
          <% album.media_assets.approved.with_attached_file.select { |asset| asset.accessible_to?(Current.user) }.each do |asset| %>
            <figure>
              <% if asset.image? %>
                <%= image_tag asset.rendition(:thumbnail) %>
              <% else %>
                <%= video_tag url_for(asset.file), controls: true %>
              <% end %>
              <figcaption><%= link_to "Download web copy", download_media_asset_path(asset) if authenticated? %></figcaption>
            </figure>
          <% end %>
        </section>
      </article>
    <% end %>
  </section>
</main>
