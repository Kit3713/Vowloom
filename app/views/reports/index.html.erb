<main class="community-page" style="--accent: <%= current_site.accent_color %>">
  <header class="community-header"><%= link_to current_site.name, community_path, class: "brand" %><%= link_to "Community", community_path %></header>
  <section class="feed-shell"><p class="eyebrow">Planning results</p><h1>Reports</h1>
    <section class="post-card"><h2>RSVPs</h2><% @events.each do |event| %><article class="management-row"><div><strong><%= event.title %></strong><br><%= event.event_invitations.attending.count %> attending · <%= event.event_invitations.declined.count %> declined · <%= event.event_invitations.pending.count %> awaiting response<% if event.meal_options.any? %><br><%= event.event_invitations.attending.where.not(meal_choice: nil).group(:meal_choice).count.map { |meal, count| "#{count} #{meal}" }.to_sentence %><% end %></div><%= link_to "Download CSV", event_report_path(event, format: :csv), class: "button button-secondary" %></article><% end %><% if @events.empty? %><p>No events created yet.</p><% end %></section>
    <section class="post-card"><h2>Questionnaires</h2><% @questionnaires.each do |questionnaire| %><article class="management-row"><div><strong><%= questionnaire.title %></strong><br><%= questionnaire.responses.count %> response<%= "s" unless questionnaire.responses.count == 1 %></div><%= link_to "Download CSV", questionnaire_report_path(questionnaire, format: :csv), class: "button button-secondary" %></article><% end %><% if @questionnaires.empty? %><p>No questionnaires created yet.</p><% end %></section>
    <section class="post-card"><h2>Registry</h2><% @collections.each do |collection| %><article><strong><%= collection.title %></strong><p><%= collection.registry_items.count %> items · <%= collection.registry_items.sum { |item| item.registry_claims.where(status: %i[reserved purchased]).sum(:quantity) } %> items reserved or purchased</p></article><% end %><% if @collections.empty? %><p>No registry collections created yet.</p><% end %></section>
  </section>
</main>
