<main class="community-page" style="--accent: <%= @site.accent_color %>">
  <header class="community-header"><%= link_to @site.name, community_path, class: "brand" %><nav><%= link_to "Events", events_path %><%= link_to "Calendar", calendar_path %><%= link_to "Main", feed_path("main") %></nav></header>
  <section class="calendar-shell">
    <header class="calendar-heading"><%= link_to "← #{@month.prev_month.strftime('%B')}", calendar_path(month: @month.prev_month.strftime('%Y-%m')), class: "button button-secondary" %><div><p class="eyebrow">Wedding schedule</p><h1><%= @month.strftime("%B %Y") %></h1></div><%= link_to "#{@month.next_month.strftime('%B')} →", calendar_path(month: @month.next_month.strftime('%Y-%m')), class: "button button-secondary" %></header>
    <table class="month-calendar"><caption class="sr-only"><%= @month.strftime("%B %Y") %> wedding events</caption><thead><tr><% Date::DAYNAMES.each do |day| %><th scope="col"><%= day %></th><% end %></tr></thead><tbody><% @weeks.each do |week| %><tr><% week.each do |day| %><td class="<%= "outside-month" unless day.month == @month.month %> <%= "today" if day == Date.current %>"><time datetime="<%= day.iso8601 %>"><%= day.day %></time><% @events_by_date.fetch(day, []).each do |event| %><%= link_to event.title, event_path(event), class: "calendar-event" %><% end %></td><% end %></tr><% end %></tbody></table>
    <section class="calendar-schedule"><p class="eyebrow">All visible events</p><h2>Schedule</h2><% @events.each do |event| %><article class="post-card"><p><strong><%= event.starts_at&.to_fs(:long) || "Time to be announced" %></strong></p><h3><%= link_to event.title, event %></h3><p><%= event.location_name %></p><%= link_to "Add to calendar", calendar_event_path(event) %></article><% end %><% if @events.empty? %><p>No visible events are scheduled yet.</p><% end %></section>
  </section>
</main>
