<main class="community-page" style="--accent: <%= @site.accent_color %>">
  <section class="feed-shell">
    <header class="page-intro"><div><p class="eyebrow">Wedding schedule</p><h1>Events</h1><p>Everything guests need to know, from travel plans to the last dance.</p></div><%= link_to "Large calendar", calendar_path, class: "button button-secondary" %></header>

    <% if authenticated? && (Current.user.owner? || Current.user.admin? || Current.user.helper?) && @site.content_live? %>
      <details class="create-panel" <%= "open" if @event.errors.any? %>><summary><span class="create-icon"><%= social_icon(:plus) %></span><span>Create an event</span></summary><%= form_with model: @event, class: "composer" do |f| %>
        <%= f.label :title %>
        <%= f.text_field :title, required: true %>
        <%= f.label :description %>
        <%= f.text_area :description %>
        <%= f.label :starts_at %>
        <%= f.datetime_local_field :starts_at %>
        <%= f.label :ends_at %>
        <%= f.datetime_local_field :ends_at %>
        <%= f.label :rsvp_deadline, "RSVP deadline (optional)" %>
        <%= f.datetime_local_field :rsvp_deadline %>
        <%= f.label :location_name %>
        <%= f.text_field :location_name %>
        <%= f.label :location_address %>
        <%= f.text_area :location_address %>
        <%= f.label :map_url, "Map link" %>
        <%= f.url_field :map_url %>
        <%= f.label :meal_options_text, "Meal choices (one per line, optional)" %>
        <%= f.text_area :meal_options_text, rows: 3 %>
        <%= f.label :visibility %>
        <%= f.select :visibility, [["Site-wide", "site_wide"], ["Invited people only", "invitees_only"]] %>
        <%= f.submit "Create event", class: "button" %>
      <% end %></details>
    <% end %>

    <section class="event-list"><% @events.each do |event| %><%= link_to event, class: "event-list-card" do %><time><strong><%= event.starts_at&.strftime("%b") || "TBA" %></strong><span><%= event.starts_at&.day || "—" %></span><small><%= event.starts_at&.year %></small></time><div><span class="event-kind"><%= event.site_wide? ? "Everyone" : "By invitation" %></span><h2><%= event.title %></h2><p><%= event.starts_at&.to_fs(:long) || "Time to be announced" %><%= " · #{event.location_name}" if event.location_name.present? %></p><p><%= truncate(event.description, length: 180) %></p><% if event.rsvp_deadline.present? %><strong class="rsvp-note">RSVP by <%= event.rsvp_deadline.to_fs(:long) %></strong><% end %></div><span class="event-arrow" aria-hidden="true">→</span><% end %><% end %></section>
    <% if @events.empty? %><section class="empty-surface"><h2>No events yet</h2><p>The wedding schedule will appear here.</p></section><% end %>
  </section>
</main>
