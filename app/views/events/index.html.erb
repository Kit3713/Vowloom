<main class="community-page" style="--accent: <%= @site.accent_color %>"><header class="community-header"><%= link_to @site.name, community_path, class: "brand" %><nav><%= link_to "Main", feed_path("main") %><%= link_to "General", feed_path("general") %><%= link_to "Events", events_path %></nav></header><section class="feed-shell"><p class="eyebrow">Schedule</p><h1>Events</h1><% if authenticated? && (Current.user.owner? || Current.user.admin? || Current.user.helper?) && @site.content_live? %><%= form_with model: @event, class: "composer" do |f| %><%= f.label :title %><%= f.text_field :title, required: true %><%= f.label :description %><%= f.text_area :description %><%= f.label :starts_at %><%= f.datetime_local_field :starts_at %><%= f.label :ends_at %><%= f.datetime_local_field :ends_at %><%= f.label :location_name %><%= f.text_field :location_name %><%= f.label :location_address %><%= f.text_area :location_address %><%= f.label :map_url, "Map link" %><%= f.url_field :map_url %><%= f.label :meal_options_text, "Meal choices (one per line, optional)" %><%= f.text_area :meal_options_text, rows: 3 %><%= f.label :visibility %><%= f.select :visibility, [["Site-wide", "site_wide"], ["Invited people only", "invitees_only"]] %><%= f.submit "Create event", class: "button" %><% end %><% end %><% @events.each do |event| %><article class="post-card"><h2><%= link_to event.title, event %></h2><p><%= event.starts_at&.to_fs(:long) || "Time to be announced" %></p><p><%= event.location_name %></p><p><%= truncate(event.description, length: 180) %></p></article><% end %></section></main>
