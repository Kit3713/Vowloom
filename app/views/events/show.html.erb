<main class="community-page" style="--accent: <%= @event.site.accent_color %>">
  <header class="community-header">
    <%= link_to @event.site.name, community_path, class: "brand" %>
    <%= link_to "All events", events_path %>
  </header>

  <section class="feed-shell">
    <p class="eyebrow">Event</p>
    <h1><%= @event.title %></h1>
    <p><%= @event.starts_at&.to_fs(:long) || "Time to be announced" %></p>
    <% if @event.rsvp_deadline.present? %>
      <p><strong>RSVP deadline:</strong> <%= @event.rsvp_deadline.to_fs(:long) %></p>
      <p><%= @event.rsvp_closed? ? "RSVPs are now closed. Please contact the couple if your plans change." : "RSVPs are open until this time." %></p>
    <% end %>
    <p><strong><%= @event.location_name %></strong><br><%= @event.location_address %></p>
    <%= link_to "Open map", @event.map_url, target: "_blank", rel: "noopener" if @event.map_url.present? %>
    <%= link_to "Add to calendar", calendar_event_path(@event) %>
    <%= simple_format(@event.description) %>

    <% invitation = Current.user&.invitee&.event_invitations&.find_by(event: @event) %>
    <% if invitation && !@household_invitations.many? %>
      <section class="post-card">
        <h2>Your RSVP</h2>
        <p>Current response: <strong><%= invitation.rsvp_status.humanize %></strong></p>
        <% if @event.site.content_live? && @event.rsvp_open? %>
          <%= form_with url: event_rsvp_path(@event), scope: :rsvp, namespace: "own_rsvp", method: :patch, class: "stack" do |f| %>
            <%= f.label :rsvp_status, "Will you attend?" %>
            <%= f.select :rsvp_status, [["Awaiting response", "pending"], ["Attending", "attending"], ["Declined", "declined"]], selected: invitation.rsvp_status %>
            <% if @event.meal_options.any? %>
              <%= f.label :meal_choice, "Meal choice" %>
              <%= f.select :meal_choice, @event.meal_options, include_blank: "Choose a meal", selected: invitation.meal_choice %>
            <% end %>
            <%= f.label :dietary_notes, "Dietary notes (optional, staff-only)" %>
            <%= f.text_area :dietary_notes, value: invitation.dietary_notes, rows: 2, maxlength: 2_000 %>
            <%= f.label :accessibility_notes, "Accessibility notes (optional, staff-only)" %>
            <%= f.text_area :accessibility_notes, value: invitation.accessibility_notes, rows: 2, maxlength: 2_000 %>
            <%= f.submit "Save RSVP", class: "button" %>
          <% end %>
        <% elsif @event.rsvp_closed? %>
          <p>RSVPs are closed. Please contact the couple if you need to update this response.</p>
        <% end %>
      </section>
    <% end %>

    <% if @household_invitations.many? %>
      <section class="post-card">
        <h2>RSVP for your household</h2>
        <p>Save a response for each invited person. Meal, dietary, and accessibility details stay attached to that person only and are visible to the wedding staff.</p>
        <% @household_invitations.each do |household_invitation| %>
          <article class="management-row">
            <% if @event.site.content_live? && @event.rsvp_open? %>
              <%= form_with url: event_rsvp_path(@event), scope: :rsvp, namespace: "household_rsvp_#{household_invitation.id}", method: :patch, class: "stack" do |f| %>
                <%= f.hidden_field :invitee_id, value: household_invitation.invitee_id %>
                <h3><%= household_invitation.invitee.full_name %></h3>
                <p>Current response: <strong><%= household_invitation.rsvp_status.humanize %></strong></p>
                <%= f.label :rsvp_status, "Response" %>
                <%= f.select :rsvp_status, [["Awaiting", "pending"], ["Attending", "attending"], ["Declined", "declined"]], selected: household_invitation.rsvp_status %>
                <% if @event.meal_options.any? %>
                  <%= f.label :meal_choice, "Meal choice" %>
                  <%= f.select :meal_choice, @event.meal_options, include_blank: "Choose a meal", selected: household_invitation.meal_choice %>
                <% end %>
                <%= f.label :dietary_notes, "Dietary notes (optional, staff-only)" %>
                <%= f.text_area :dietary_notes, value: household_invitation.dietary_notes, rows: 2, maxlength: 2_000 %>
                <%= f.label :accessibility_notes, "Accessibility notes (optional, staff-only)" %>
                <%= f.text_area :accessibility_notes, value: household_invitation.accessibility_notes, rows: 2, maxlength: 2_000 %>
                <%= f.submit "Save", class: "button button-secondary" %>
              <% end %>
            <% else %>
              <div>
                <strong><%= household_invitation.invitee.full_name %></strong><br>
                <%= household_invitation.rsvp_status.humanize %>
              </div>
            <% end %>
          </article>
        <% end %>
      </section>
    <% end %>

    <% if authenticated? && (Current.user.owner? || Current.user.admin? || Current.user.helper?) && @event.site.content_live? %>
      <section class="post-card">
        <h2>Edit event</h2>
        <%= form_with model: @event, class: "stack" do |f| %>
          <%= f.label :title %><%= f.text_field :title, required: true %>
          <%= f.label :description %><%= f.text_area :description %>
          <%= f.label :starts_at %><%= f.datetime_local_field :starts_at %>
          <%= f.label :ends_at %><%= f.datetime_local_field :ends_at %>
          <%= f.label :rsvp_deadline, "RSVP deadline (optional)" %><%= f.datetime_local_field :rsvp_deadline %>
          <%= f.label :location_name %><%= f.text_field :location_name %>
          <%= f.label :location_address %><%= f.text_area :location_address %>
          <%= f.label :map_url, "Map link" %><%= f.url_field :map_url %>
          <%= f.label :meal_options_text, "Meal choices (one per line, optional)" %><%= f.text_area :meal_options_text, rows: 3 %>
          <%= f.label :visibility %><%= f.select :visibility, [["Site-wide", "site_wide"], ["Invited people only", "invitees_only"]] %>
          <%= f.submit "Save event", class: "button" %>
        <% end %>
        <%= button_to "Delete event", @event, method: :delete, class: "text-button", form: { data: { turbo_confirm: "Delete this event and its RSVPs? This cannot be undone." } } %>
      </section>
    <% end %>

    <% if @available_invitees %>
      <section class="post-card">
        <h2>Invitees and RSVP</h2>
        <p>Use this area to add an invitee or record a paper, phone, or in-person response. Staff can update these even after the member RSVP deadline.</p>
        <%= form_with url: event_event_invitations_path(@event), class: "inline-form" do |f| %>
          <%= f.label :invitee_id, "Invite a person" %>
          <%= f.select :invitee_id, @available_invitees.reject { |invitee| @event.invitees.include?(invitee) }.map { |invitee| [invitee.full_name, invitee.id] }, include_blank: "Choose an invitee" %>
          <%= f.submit "Invite", class: "button button-secondary" %>
        <% end %>
        <% @event.event_invitations.includes(:invitee).order("invitees.last_name", "invitees.first_name").each do |event_invitation| %>
          <article class="post-card">
            <h3><%= event_invitation.invitee.full_name %></h3>
            <%= form_with model: [@event, event_invitation], class: "stack" do |f| %>
              <%= f.label :rsvp_status, "RSVP" %>
              <%= f.select :rsvp_status, [["Awaiting", "pending"], ["Attending", "attending"], ["Declined", "declined"]], selected: event_invitation.rsvp_status %>
              <% if @event.meal_options.any? %>
                <%= f.label :meal_choice, "Meal choice" %>
                <%= f.select :meal_choice, @event.meal_options, include_blank: "No meal selected", selected: event_invitation.meal_choice %>
              <% end %>
              <%= f.label :dietary_notes, "Dietary notes (staff only)" %>
              <%= f.text_area :dietary_notes, value: event_invitation.dietary_notes, rows: 2, maxlength: 2_000 %>
              <%= f.label :accessibility_notes, "Accessibility notes (staff only)" %>
              <%= f.text_area :accessibility_notes, value: event_invitation.accessibility_notes, rows: 2, maxlength: 2_000 %>
              <%= f.submit "Save RSVP", class: "button button-secondary" %>
            <% end %>
            <%= button_to "Remove", event_event_invitation_path(@event, event_invitation), method: :delete, class: "text-button" %>
          </article>
        <% end %>
      </section>
    <% end %>

    <% if @event_history %>
      <section class="post-card">
        <h2>Event history</h2>
        <p>Staff-only activity for this event. RSVP details are not copied into the history.</p>
        <% @event_history.each do |history| %>
          <article class="management-row"><div><strong><%= history.action.tr(".", " ").humanize %></strong><br><%= history.actor.display_name %> · <%= history.created_at.to_fs(:long) %><% if history.metadata["changed_fields"].present? %><br>Changed: <%= history.metadata["changed_fields"].to_sentence %><% end %></div></article>
        <% end %>
        <% if @event_history.empty? %><p>No event changes recorded yet.</p><% end %>
      </section>
    <% end %>
  </section>
</main>
