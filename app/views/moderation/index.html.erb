<main class="community-page" style="--accent: <%= current_site.accent_color %>">
  <header class="community-header"><%= link_to current_site.name, community_path, class: "brand" %><%= link_to "Community", community_path %></header>
  <section class="feed-shell"><p class="eyebrow">Content safety</p><h1>Moderation</h1><% @reports.each do |report| %><article class="post-card"><p><strong><%= report.reportable_type %></strong> reported by <%= report.reporter.display_name %> <%= time_ago_in_words(report.created_at) %> ago</p><p><%= report.reason %></p><% if report.reportable.respond_to?(:body) %><blockquote><%= truncate(report.reportable.body, length: 300) %></blockquote><% elsif report.reportable.is_a?(MediaAsset) %><p><%= report.reportable.file.filename %></p><% end %><div class="actions"><%= button_to "Hide", moderate_content_path(report.reportable_type, report.reportable_id), method: :patch, params: { moderation_action: "hide" }, class: "button" %><%= button_to "Restore", moderate_content_path(report.reportable_type, report.reportable_id), method: :patch, params: { moderation_action: "restore" }, class: "button button-secondary" %><% if report.reportable.is_a?(Post) %><%= button_to "Lock comments", moderate_content_path("Post", report.reportable_id), method: :patch, params: { moderation_action: "lock" }, class: "button button-secondary" %><% end %></div></article><% end %><% if @reports.empty? %><p>No open reports.</p><% end %></section>
</main>
