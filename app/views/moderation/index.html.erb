<main class="community-page" style="--accent: <%= current_site.accent_color %>">
  <section class="feed-shell">
    <header class="page-intro"><div><p class="eyebrow">Content safety</p><h1>Moderation</h1><p>Review reports and recover posts or comments that were deleted from the timeline.</p></div></header>
    <section class="post-card"><h2>Open reports</h2><% @reports.each do |report| %><article class="management-row"><div><p><strong><%= report.reportable_type %></strong> reported by <%= report.reporter.display_name %> <%= time_ago_in_words(report.created_at) %> ago</p><p><%= report.reason %></p><blockquote><%= truncate(report.reportable.respond_to?(:body) ? report.reportable.body : report.reportable.to_s, length: 300) %></blockquote></div><div class="actions"><%= button_to "Hide", moderate_content_path(report.reportable_type, report.reportable_id), method: :patch, params: { moderation_action: "hide" }, class: "button" %><%= button_to "Restore", moderate_content_path(report.reportable_type, report.reportable_id), method: :patch, params: { moderation_action: "restore" }, class: "button button-secondary" %></div></article><% end %><p class="muted"><%= "No open reports." if @reports.empty? %></p></section>
    <section class="post-card"><h2>Recently deleted posts</h2><% @deleted_posts.each do |post| %><article class="management-row"><div><strong><%= post.title.presence || truncate(post.body, length: 80) %></strong><p class="muted"><%= post.user.display_name %> · deleted <%= time_ago_in_words(post.hidden_at) %> ago</p></div><%= button_to "Restore post", moderate_content_path("Post", post.id), method: :patch, params: { moderation_action: "restore" }, class: "button button-secondary" %></article><% end %><p class="muted"><%= "No deleted posts." if @deleted_posts.empty? %></p></section>
    <section class="post-card"><h2>Recently deleted comments</h2><% @deleted_comments.each do |comment| %><article class="management-row"><div><strong><%= comment.user.display_name %></strong><p><%= truncate(comment.body, length: 140) %></p><p class="muted">Deleted <%= time_ago_in_words(comment.hidden_at) %> ago</p></div><%= button_to "Restore comment", moderate_content_path("Comment", comment.id), method: :patch, params: { moderation_action: "restore" }, class: "button button-secondary" %></article><% end %><p class="muted"><%= "No deleted comments." if @deleted_comments.empty? %></p></section>
  </section>
</main>
