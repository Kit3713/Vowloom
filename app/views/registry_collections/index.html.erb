<main class="community-page" style="--accent: <%= @site.accent_color %>">
  <header class="community-header"><%= link_to @site.name, community_path, class: "brand" %><nav><%= link_to "Main", feed_path("main") %><%= link_to "Events", events_path %><%= link_to "Registry", registry_collections_path %></nav></header>
  <section class="feed-shell"><p class="eyebrow">Wedding registry</p><h1>Registry</h1>
    <% if authenticated? && (Current.user.owner? || Current.user.admin? || Current.user.helper?) && @site.content_live? %><%= form_with model: @collection, class: "composer" do |f| %><%= f.label :title, "Collection name" %><%= f.text_field :title, required: true %><%= f.label :description %><%= f.text_area :description %><%= f.label :visibility %><%= f.select :visibility, [["Everyone", "everyone"], ["Members only", "members_only"]] %><%= f.submit "Create collection", class: "button" %><% end %><% end %>
    <% @collections.each do |collection| %><article class="post-card"><h2><%= collection.title %></h2><%= simple_format(collection.description) %><% collection.registry_items.where(published: true).each do |item| %><section class="registry-item"><strong><%= item.title %></strong><span><%= item.available_quantity %> remaining</span><p><%= item.description %></p><%= link_to "View item", item.external_url, target: "_blank", rel: "noopener" if item.external_url.present? %><% claim = @my_claims[item.id] %><% if claim %><p>Your claim: <strong><%= claim.status.humanize %></strong></p><% if authenticated? && @site.content_live? && claim.reserved? %><%= form_with model: claim, class: "inline-form" do |f| %><%= f.label :status, "Update claim" %><%= f.select :status, [["Purchased", "purchased"], ["Release reservation", "released"]] %><%= f.submit "Save", class: "button button-secondary" %><% end %><% end %><% elsif authenticated? && @site.content_live? && item.available_quantity.positive? %><%= button_to "Reserve one", registry_item_claims_path(item), params: { quantity: 1 }, class: "button" %><% end %></section><% end %><% if authenticated? && (Current.user.owner? || Current.user.admin? || Current.user.helper?) && @site.content_live? %><%= form_with url: registry_collection_registry_items_path(collection), class: "stack" do |f| %><%= f.label "registry_item[title]", "Add item" %><%= f.text_field "registry_item[title]", required: true %><%= f.label "registry_item[external_url]", "Purchase link" %><%= f.url_field "registry_item[external_url]" %><%= f.label "registry_item[quantity_requested]", "Quantity" %><%= f.number_field "registry_item[quantity_requested]", value: 1, min: 1 %><%= f.submit "Add item", class: "button button-secondary" %><% end %><% end %></article><% end %>
    <% if @staff_claims.any? %><section class="post-card"><h2>Private gift tracking</h2><% @staff_claims.each do |claim| %><article class="management-row"><div><strong><%= claim.registry_item.title %></strong><br><%= claim.user.display_name %> · <%= claim.status.humanize %> · <%= claim.received_at ? "Received" : "Not received" %> · <%= claim.thank_you_sent_at ? "Thank-you sent" : "Thank-you pending" %></div><% if @site.content_live? %><%= form_with model: claim, class: "inline-form" do |f| %><%= f.label :private_note, "Private note" %><%= f.text_field :private_note %><%= f.submit "Save note", class: "button button-secondary" %><% end %><%= button_to "Mark received", registry_claim_path(claim), method: :patch, params: { registry_claim: {}, mark_received: 1 }, class: "text-button" unless claim.received_at %><%= button_to "Mark thank-you sent", registry_claim_path(claim), method: :patch, params: { registry_claim: {}, mark_thank_you_sent: 1 }, class: "text-button" unless claim.thank_you_sent_at %><% end %></article><% end %></section><% end %>
  </section>
</main>
