<main class="community-page">
  <header class="community-header"><%= link_to current_site.name, community_path, class: "brand" %><%= link_to "Back", community_path %></header>
  <section class="feed-shell">
    <h1>Kiosk displays</h1>
    <p>Displays are read-only public presentations. They show only approved featured media, site-wide events, and public Main announcements.</p>
    <%= form_with model: @display, class: "composer" do |f| %>
      <%= f.label :name %><%= f.text_field :name, required: true %>
      <%= f.label :mode, "Preset" %><%= f.select :mode, [["Mixed information and media", "mixed"], ["Gallery photo wall", "gallery"], ["Gallery slideshow", "slideshow"], ["Event schedule / now and next", "schedule"], ["Pinned information board", "information"]] %>
      <%= f.label :refresh_seconds, "Refresh every (seconds)" %><%= f.number_field :refresh_seconds, value: 60, min: 10, max: 3600, required: true %>
      <span><%= f.check_box :show_qr_placeholder %><%= f.label :show_qr_placeholder, "Show a join reminder" %></span>
      <%= f.submit "Create display", class: "button" %>
    <% end %>
    <% @displays.each do |display| %>
      <article class="post-card">
        <strong><%= display.name %></strong><p><%= display.mode.humanize %> · refreshes every <%= display.refresh_seconds %> seconds · <%= display.enabled? ? "Enabled" : "Disabled" %></p>
        <p><%= link_to public_display_url(display.access_token), public_display_path(display.access_token), target: "_blank", rel: "noopener" if display.enabled? %></p>
        <% if authenticated? && (Current.user.owner? || Current.user.admin?) %>
          <%= form_with model: display, class: "inline-form" do |f| %>
            <%= f.label :mode, "Preset" %><%= f.select :mode, [["Mixed", "mixed"], ["Photo wall", "gallery"], ["Slideshow", "slideshow"], ["Schedule", "schedule"], ["Information", "information"]] %>
            <%= f.label :refresh_seconds, "Seconds" %><%= f.number_field :refresh_seconds, min: 10, max: 3600, required: true %>
            <%= f.check_box :show_qr_placeholder %><%= f.label :show_qr_placeholder, "Join reminder" %>
            <%= f.hidden_field :enabled, value: display.enabled? %><%= f.submit "Save display", class: "button button-secondary" %>
          <% end %>
          <div class="actions"><%= form_with model: display, class: "inline-form" do |f| %><%= f.hidden_field :enabled, value: !display.enabled? %><%= f.submit(display.enabled? ? "Disable link" : "Enable link", class: "button button-secondary") %><% end %><%= button_to "Replace link", kiosk_display_path(display), method: :patch, params: { regenerate: 1 }, class: "button button-secondary" %></div>
        <% end %>
      </article>
    <% end %>
  </section>
</main>
