<main class="community-page" style="--accent: <%= @site.accent_color %>"><header class="community-header"><%= link_to @site.name, community_path, class: "brand" %><%= link_to "Back to community", community_path %></header><section class="feed-shell"><p class="eyebrow">Live conversation</p><h1>Wedding chat</h1><% if @conversation %><%= turbo_stream_from @conversation %><section class="post-card chat-thread"><div id="<%= dom_id(@conversation, :comments) %>"><% @conversation.comments.visible.each do |comment| %><%= render "comments/comment", comment: %><% end %></div><% if authenticated? && @site.content_live? %><%= form_with url: post_comments_path(@conversation), class: "comment-form" do |f| %><%= f.text_field :body, name: "comment[body]", required: true, placeholder: "Send a message", autocomplete: "off" %><%= f.submit "Send" %><% end %><% end %></section><% elsif authenticated? && (Current.user.owner? || Current.user.admin? || Current.user.helper?) && @site.content_live? %><%= button_to "Open wedding chat", chat_path, method: :post, class: "button" %><% else %><p>The wedding chat has not opened yet.</p><% end %></section></main>
