<main class="community-page" style="--accent: <%= @site.accent_color %>">
  <header class="community-header"><%= link_to @site.name, root_path, class: "brand" %><nav><%= link_to "Main", feed_path("main") %><%= link_to "General", feed_path("general") %><%= link_to "Events", events_path %><%= link_to "Calendar", calendar_path %><%= link_to "Questions", questionnaires_path %><%= link_to "Registry", registry_collections_path %><%= link_to "Gallery", gallery_path %><%= link_to "Groups", groups_path %><%= link_to "Chat", chat_path %><%= link_to "Search archive", archive_search_path if @site.content_frozen? %><%= link_to "Inbox", couple_inbox_path if authenticated? %><% if authenticated? && (Current.user.owner? || Current.user.admin? || Current.user.helper?) %><%= link_to "Displays", kiosk_displays_path %><% end %><%= link_to "Moderation", moderation_path if authenticated? && (Current.user.owner? || Current.user.admin?) %><%= link_to "Reports", reports_path if authenticated? && (Current.user.owner? || Current.user.admin?) %><%= link_to "Audit log", audit_events_path if authenticated? && (Current.user.owner? || Current.user.admin?) %><%= link_to "Manage", management_path if authenticated? && Current.user.owner? %></nav><% if authenticated? %><span><%= link_to "Profile", edit_profile_path %> · Signed in as <%= Current.user.display_name %></span><% else %><%= link_to "Sign in", new_session_path, class: "button button-secondary" %><% end %></header>
  <section class="community-hero" id="main"><p class="eyebrow"><%= @site.content_live? ? "Live community" : "Frozen wedding archive" %></p><h1><%= @site.name %></h1><p><%= @site.landing_message.presence || "Wedding news, plans, photos, and the history we create together." %></p></section>
  <section class="empty-surface" id="events"><h2>Start with the people</h2><p>Invitees, events, RSVPs, posts, questionnaires, and registry collections will appear here as they are created.</p></section>
</main>
