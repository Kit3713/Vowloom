<main class="community-page" style="--accent: <%= @site.accent_color %>">
  <section class="community-profile">
    <% if @site.banner_image.attached? %>
      <%= image_tag @site.banner_image, class: "community-cover", alt: "" %>
    <% else %>
      <div class="community-cover community-cover-placeholder" aria-hidden="true"></div>
    <% end %>
    <div class="community-profile-body">
      <div class="community-monogram" aria-hidden="true">V</div>
      <div class="community-profile-copy">
        <p class="eyebrow"><%= @site.content_live? ? "Wedding community" : "Preserved wedding archive" %></p>
        <h1><%= @site.name %></h1>
        <p><%= @site.landing_message.presence || "Wedding news, plans, photos, and the story we create together." %></p>
      </div>
    </div>
    <nav class="profile-tabs" aria-label="Wedding home sections">
      <%= link_to "Updates", feed_path("main") %>
      <%= link_to "Community", feed_path("general") %>
      <%= link_to "Photos", gallery_path %>
      <%= link_to "About", events_path %>
    </nav>
  </section>

  <% if authenticated? && (@rsvp_invitations.any? || @open_questionnaires.any?) %>
    <section class="todo-card" aria-label="Your wedding to-dos">
      <div class="todo-heading"><span class="todo-icon"><%= social_icon(:calendar) %></span><div><p class="eyebrow">For you</p><h2>Your next steps</h2></div></div>
      <% @rsvp_invitations.each do |invitation| %>
        <%= link_to event_path(invitation.event), class: "todo-row" do %><span><strong>RSVP for <%= invitation.event.title %></strong><small><%= invitation.event.starts_at&.to_fs(:long) || "Date to be announced" %></small></span><span aria-hidden="true">→</span><% end %>
      <% end %>
      <% @open_questionnaires.each do |questionnaire| %>
        <%= link_to questionnaire_path(questionnaire), class: "todo-row" do %><span><strong><%= questionnaire.title %></strong><small><%= questionnaire.closes_at ? "Respond by #{questionnaire.closes_at.to_fs(:long)}" : "Open questionnaire" %></small></span><span aria-hidden="true">→</span><% end %>
      <% end %>
    </section>
  <% end %>

  <section class="home-section-heading"><div><p class="eyebrow">From the couple</p><h2>Latest updates</h2></div><%= link_to "View all", feed_path("main") %></section>
  <section class="home-feed">
    <% @announcements.each do |post| %>
      <article class="post-card home-post">
        <header>
          <span class="author"><% if post.user.profile_photo.attached? %><%= image_tag post.user.profile_photo, class: "avatar", alt: "" %><% else %><span class="avatar avatar-fallback"><%= person_initials(post.user) %></span><% end %><span><strong><%= post.user.display_name %></strong><small>Official update</small></span></span>
          <time datetime="<%= post.published_at.iso8601 %>"><%= time_ago_in_words(post.published_at) %> ago</time>
        </header>
        <% if post.title.present? %><h2><%= link_to post.title, feed_path("main", anchor: dom_id(post)) %></h2><% end %>
        <%= simple_format(truncate(post.body, length: 360)) %>
        <footer><%= pluralize(post.comments.visible.count, "comment") %></footer>
      </article>
    <% end %>
    <% if @announcements.empty? %><section class="empty-surface"><h2>The story starts here</h2><p>Official updates from the couple will appear in this space.</p></section><% end %>
  </section>

  <section class="home-section-heading"><div><p class="eyebrow">Save the date</p><h2>Coming up</h2></div><%= link_to "Events & calendar", events_path %></section>
  <section class="event-strip">
    <% @upcoming_events.each do |event| %>
      <%= link_to event_path(event), class: "event-preview" do %>
        <time><strong><%= event.starts_at&.strftime("%b") || "TBA" %></strong><span><%= event.starts_at&.day || "—" %></span></time>
        <div><h3><%= event.title %></h3><p><%= event.starts_at&.to_fs(:long) || "Time to be announced" %></p><small><%= event.location_name.presence || "Location coming soon" %></small></div>
      <% end %>
    <% end %>
    <% if @upcoming_events.empty? %><p class="muted">Wedding events will appear here as the schedule takes shape.</p><% end %>
  </section>
</main>
