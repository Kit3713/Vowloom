<main class="community-page" style="--accent: <%= current_site.accent_color %>">
  <header class="community-header"><%= link_to current_site.name, community_path, class: "brand" %><%= link_to "Inbox", couple_inbox_path %></header>
  <section class="feed-shell"><p class="eyebrow">Private conversation</p><article class="post-card"><h1><%= @conversation.title.presence || "Conversation" %></h1><p><strong><%= @conversation.user.display_name %></strong></p><%= simple_format(@conversation.body) %><%= turbo_stream_from @conversation %><%= render "comments/thread", post: @conversation %></article></section>
</main>
