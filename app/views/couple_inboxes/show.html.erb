<main class="community-page" style="--accent: <%= current_site.accent_color %>">
  <header class="community-header"><%= link_to current_site.name, community_path, class: "brand" %><%= link_to "Inbox", couple_inbox_path %></header>
  <section class="feed-shell"><p class="eyebrow">Private conversation</p><article class="post-card"><h1><%= @conversation.title.presence || "Conversation" %></h1><p><strong><%= @conversation.user.display_name %></strong></p><%= simple_format(@conversation.body) %><section class="comments"><% @comments.each do |comment| %><p><strong><%= comment.user.display_name %></strong> <%= comment.body %></p><% end %><% if current_site.content_live? && @conversation.commentable_by?(Current.user) %><%= form_with url: post_comments_path(@conversation), class: "comment-form" do |f| %><%= f.text_field :body, placeholder: "Write a private reply", required: true %><%= f.submit "Reply", class: "button" %><% end %><% end %></section></article></section>
</main>
