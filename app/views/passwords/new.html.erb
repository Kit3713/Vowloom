<h1>Forgot your password?</h1>

<% if EmailDeliveryConfiguration.configured? %>
  <%= form_with url: passwords_path do |form| %>
    <%= form.email_field :recovery_email, required: true, autofocus: true, autocomplete: "email", placeholder: "Recovery email", value: params[:recovery_email] %><br>
    <%= form.submit "Email reset instructions", class: "button" %>
  <% end %>
<% else %>
  <%= render "shared/email_delivery_status" %>
  <p>No reset message can be sent from this installation yet.</p>
  <%= link_to "Back to sign in", new_session_path %>
<% end %>
