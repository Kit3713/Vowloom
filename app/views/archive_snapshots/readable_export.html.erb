<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex, nofollow">
    <title><%= @payload.dig(:site, :name) %> — preserved wedding archive</title>
    <style>
      :root { color-scheme: light; --accent: <%= @payload.dig(:site, :accent_color) %>; }
      * { box-sizing: border-box; }
      body { color: #1e1b1d; font: 16px/1.55 system-ui, sans-serif; margin: 0 auto; max-width: 54rem; padding: 2rem; }
      h1, h2, h3 { line-height: 1.18; } h1 { border-bottom: .3rem solid var(--accent); padding-bottom: .75rem; }
      section, article { break-inside: avoid; border-bottom: 1px solid #ddd; padding: 1.25rem 0; }
      .meta, .notice { color: #5a5357; } .notice { background: #f6f2f4; border-left: .25rem solid var(--accent); padding: .75rem 1rem; }
      .space { color: #5a5357; font-size: .9rem; text-transform: capitalize; } .comment { border-left: .2rem solid #ddd; margin: 1rem 0; padding-left: 1rem; }
      ul { padding-left: 1.25rem; } code { overflow-wrap: anywhere; }
      @media print { body { max-width: none; padding: .5in; } a { color: inherit; text-decoration: none; } }
    </style>
  </head>
  <body>
    <header>
      <p class="meta">Vowloom preserved wedding archive · <%= @include_private ? "complete Owner export" : "public-safe export" %></p>
      <h1><%= @payload.dig(:site, :name) %></h1>
      <% if @payload.dig(:site, :wedding_date).present? %><p>Wedding date: <%= @payload.dig(:site, :wedding_date) %></p><% end %>
      <% if @payload.dig(:site, :landing_message).present? %><p><%= @payload.dig(:site, :landing_message) %></p><% end %>
      <p class="notice">This is a standalone, script-free reading copy created <%= @payload.fetch(:generated_at) %>. It records text and media metadata. Keep it with the matching JSON manifest, database backup, and Active Storage media backup to preserve original files.</p>
      <p class="meta">Snapshot checksum: <code><%= @payload.fetch(:checksum, "Legacy snapshot; verify its accompanying JSON manifest") %></code></p>
    </header>

    <section>
      <h2>Contents</h2>
      <ul><% @payload.fetch(:content_counts).each do |name, count| %><li><%= count %> <%= name.to_s.humanize.downcase %></li><% end %></ul>
      <p class="meta"><%= @payload.fetch(:privacy) %>.</p>
    </section>

    <section>
      <h2>Schedule</h2>
      <% if @payload.fetch(:events).any? %><% @payload.fetch(:events).each do |event| %><article><h3><%= event.fetch(:title) %></h3><p><%= event[:starts_at].presence || "Time to be announced" %><% if event[:ends_at].present? %> – <%= event[:ends_at] %><% end %></p><% if event[:location_name].present? %><p><%= event[:location_name] %><% if event[:location_address].present? %> · <%= event[:location_address] %><% end %></p><% end %><% if event[:description].present? %><p><%= event[:description] %></p><% end %><% if event[:rsvp_totals].present? %><p class="meta">RSVPs: <%= event[:rsvp_totals].map { |status, count| "#{count} #{status}" }.to_sentence %></p><% end %><% if event[:rsvps].present? %><ul><% event[:rsvps].each do |rsvp| %><li><strong><%= rsvp[:invitee] %></strong>: <%= rsvp[:status] %><% if rsvp[:meal_choice].present? %> · <%= rsvp[:meal_choice] %><% end %><% if rsvp[:dietary_notes].present? %> · dietary: <%= rsvp[:dietary_notes] %><% end %><% if rsvp[:accessibility_notes].present? %> · accessibility: <%= rsvp[:accessibility_notes] %><% end %></li><% end %></ul><% end %></article><% end %><% else %><p>No events were included in this export.</p><% end %>
    </section>

    <section>
      <h2>Groups</h2>
      <% if @payload.fetch(:groups).any? %><ul><% @payload.fetch(:groups).each do |group| %><li><strong><%= group.fetch(:name) %></strong> (<%= group.fetch(:participation) %>)<% if group[:description].present? %> — <%= group[:description] %><% end %></li><% end %></ul><% else %><p>No groups were included in this export.</p><% end %>
    </section>

    <section>
      <h2>Questionnaires</h2>
      <% if @payload.fetch(:questionnaires, []).any? %><% @payload.fetch(:questionnaires).each do |questionnaire| %><article><h3><%= questionnaire[:title] %></h3><% if questionnaire[:introduction].present? %><p><%= questionnaire[:introduction] %></p><% end %><ul><% questionnaire.fetch(:questions).each do |question| %><li><strong><%= question[:prompt] %></strong><% if question[:aggregate].present? %> · <%= question[:aggregate][:answered_count] %> answers<% if question[:aggregate][:choice_counts].present? %> (<%= question[:aggregate][:choice_counts].map { |choice, count| "#{choice}: #{count}" }.to_sentence %>)<% end %><% end %></li><% end %></ul><% if questionnaire[:responses].present? %><h4>Recorded responses</h4><% questionnaire[:responses].each do |response| %><article><p class="meta"><%= response[:respondent] %> · <%= response[:submitted_at] %></p><ul><% response[:answers].each do |answer| %><li><strong><%= answer[:prompt] %></strong><% if answer[:value].present? %>: <%= Array(answer[:value]).to_sentence %><% end %><% if answer[:file].present? %> · attached file: <%= answer[:file][:filename] %><% end %></li><% end %></ul></article><% end %><% end %></article><% end %><% else %><p>No questionnaire results were included in this export.</p><% end %>
    </section>

    <section>
      <h2>Registry record</h2>
      <% if @payload.fetch(:registry, []).any? %><% @payload.fetch(:registry).each do |collection| %><article><h3><%= collection[:title] %></h3><% if collection[:description].present? %><p><%= collection[:description] %></p><% end %><ul><% collection.fetch(:items).each do |item| %><li><strong><%= item[:title] %></strong> · <%= item[:available_quantity] %> of <%= item[:quantity_requested] %> available<% if item[:category].present? %> · <%= item[:category] %><% end %><% if item[:claims].present? %><ul><% item[:claims].each do |claim| %><li><%= claim[:purchaser] %>: <%= claim[:quantity] %> <%= claim[:status] %><% if claim[:private_note].present? %> · <%= claim[:private_note] %><% end %></li><% end %></ul><% end %></li><% end %></ul></article><% end %><% else %><p>No registry items were included in this export.</p><% end %>
    </section>

    <% if @payload.fetch(:tasks, []).any? %><section><h2>Planning tasks</h2><% @payload.fetch(:tasks).each do |task| %><article><h3><%= task[:title] %></h3><p class="meta"><%= task[:group] %><% if task[:assigned_to].present? %> · assigned to <%= task[:assigned_to] %><% end %><% if task[:due_on].present? %> · due <%= task[:due_on] %><% end %><% if task[:completed_at].present? %> · completed <%= task[:completed_at] %><% end %></p><% if task[:description].present? %><p><%= task[:description] %></p><% end %><% task[:comments].each do |comment| %><div class="comment"><p class="meta"><%= comment[:author] %> · <%= comment[:created_at] %></p><p><%= comment[:body] %></p></div><% end %></article><% end %></section><% end %>

    <main>
      <h2>Community history</h2>
      <% if @payload.fetch(:posts).any? %><% @payload.fetch(:posts).each do |post| %><article><p class="space"><%= post.fetch(:space).humanize %></p><% if post[:title].present? %><h3><%= post[:title] %></h3><% end %><p class="meta"><%= post.fetch(:author) %> · <%= post[:published_at] %></p><div><%= simple_format(post.fetch(:body)) %></div><% post.fetch(:comments).each do |comment| %><div class="comment"><p class="meta"><%= comment.fetch(:author) %> · <%= comment[:created_at] %></p><div><%= simple_format(comment.fetch(:body)) %></div></div><% end %></article><% end %><% else %><p>No posts were included in this export.</p><% end %>
    </main>

    <section>
      <h2>Media record</h2>
      <% if @payload.fetch(:media).any? %><ul><% @payload.fetch(:media).each do |media| %><% original = media.fetch(:original) %><li><strong><%= original.fetch(:filename) %></strong> · <%= number_to_human_size(original.fetch(:byte_size)) %> · SHA-style storage checksum <code><%= original.fetch(:checksum) %></code><% if media[:caption].present? %> — <%= media[:caption] %><% end %></li><% end %></ul><% else %><p>No approved media was included in this export.</p><% end %>
    </section>
  </body>
</html>
