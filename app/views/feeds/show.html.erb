<main class="community-page" style="--accent: <%= @site.accent_color %>">
  <section class="feed-shell">
    <header class="page-intro">
      <div><p class="eyebrow"><%= @space == "main" ? "From the couple" : "Everyone together" %></p><h1><%= @space == "main" ? "Main updates" : "General" %></h1><p><%= @space == "main" ? "The official timeline for plans, announcements, and moments that matter." : "A shared place for guests to post messages, questions, photos, and wedding-day memories." %></p></div>
    </header>

    <% can_publish = authenticated? && @site.content_live? && ((@space == "main" && (Current.user.owner? || Current.user.admin? || Current.user.helper?)) || @space == "general") %>
    <% if can_publish %>
      <details class="create-panel" <%= "open" if @post.errors.any? %>>
        <summary>
          <% if Current.user.profile_photo.attached? %><%= image_tag Current.user.profile_photo, class: "avatar", alt: "" %><% else %><span class="avatar avatar-fallback"><%= person_initials(Current.user) %></span><% end %>
          <span><%= @space == "main" ? "Share an update with everyone" : "Write something to the wedding community" %></span>
        </summary>
        <%= form_with model: @post, class: "composer" do |f| %>
          <%= f.hidden_field :space, value: @space %>
          <%= f.label :title, "Title (optional)" %><%= f.text_field :title, placeholder: "Give this post a headline" %>
          <%= f.label :body, "Post" %><%= f.text_area :body, required: true, rows: 5, placeholder: "What would you like to share?" %>
          <%= f.label :files, "Add photos or videos" %><%= f.file_field :files, multiple: true, accept: "image/*,video/*" %>
          <% if @space == "general" %><%= f.label :visibility, "Audience" %><%= f.select :visibility, [["Members only", "members_only"], ["Everyone, including visitors", "everyone"]] %>
          <% elsif Current.user.owner? || Current.user.admin? %>
            <fieldset class="announcement-email-option"><legend>Important announcement</legend><% if @important_announcement_email_available %><%= f.check_box :send_important_announcement_email %><%= f.label :send_important_announcement_email, "Email this update to opted-in invited members" %><% else %><p>Email delivery becomes available after SMTP is configured.</p><% end %></fieldset>
          <% end %>
          <div class="composer-actions"><span class="muted">Photos and video are kept with the wedding history.</span><%= f.submit "Publish post", class: "button" %></div>
        <% end %>
      </details>
    <% end %>

    <% @posts.each do |post| %>
      <article class="post-card" id="<%= dom_id(post) %>">
        <header>
          <span class="author"><% if post.user.profile_photo.attached? %><%= image_tag post.user.profile_photo, class: "avatar", alt: "" %><% else %><span class="avatar avatar-fallback"><%= person_initials(post.user) %></span><% end %><span class="author-copy"><strong><%= post.user.display_name %></strong><small><%= post.main? ? "Official update" : "Wedding member" %></small></span></span>
          <time datetime="<%= post.published_at.iso8601 %>" title="<%= post.published_at.to_fs(:long) %>"><%= time_ago_in_words(post.published_at) %> ago</time>
        </header>
        <%= tag.p("Pinned update", class: "eyebrow pinned-label") if post.pinned? %>
        <% if post.title.present? %><h2><%= post.title %></h2><% end %>
        <div class="post-body"><%= simple_format(post.body) %></div>
        <section class="media-grid"><% post.media_assets.where.not(status: :hidden).with_attached_file.each do |asset| %><figure><% if asset.image? %><%= image_tag asset.rendition(:feed) %><% else %><%= video_tag url_for(asset.file), controls: true %><% end %><figcaption><%= asset.caption %></figcaption></figure><% end %></section>
        <footer><span><%= pluralize(post.comments.visible.count, "comment") %></span><span class="post-tools"><%= render "moderation_reports/button", reportable: post if authenticated? && @site.content_live? %><% if authenticated? && @site.content_live? && post.main? && (Current.user.owner? || Current.user.admin?) %><%= form_with model: post, class: "inline-form" do |f| %><%= f.hidden_field :pinned, value: !post.pinned? %><%= f.submit(post.pinned? ? "Unpin" : "Pin", class: "text-button") %><% end %><% end %></span></footer>
        <% if post.comments_enabled? %>
          <section class="comments"><% post.comments.visible.each do |comment| %><p><strong><%= comment.user.display_name %></strong> <%= comment.body %> <%= render "moderation_reports/button", reportable: comment if authenticated? && @site.content_live? %></p><% end %>
            <% if authenticated? && @site.content_live? %><%= form_with url: post_comments_path(post), class: "comment-form" do |f| %><%= f.text_field :body, name: "comment[body]", required: true, placeholder: "Write a comment…", aria: { label: "Write a comment" } %><%= f.submit "Reply" %><% end %><% end %>
          </section>
        <% end %>
      </article>
    <% end %>
    <% if @posts.empty? %><section class="empty-surface"><h2>No posts yet</h2><p><%= @space == "main" ? "Official updates will appear here." : "Be the first member to add a message or photo." %></p></section><% end %>
  </section>
</main>
