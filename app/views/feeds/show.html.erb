<main class="community-page" style="--accent: <%= @site.accent_color %>">
  <header class="community-header"><%= link_to @site.name, community_path, class: "brand" %><nav><%= link_to "Main", feed_path("main") %><%= link_to "General", feed_path("general") %><%= link_to "Events", events_path %><%= link_to "Gallery", gallery_path %><%= link_to "Groups", groups_path %></nav></header>
  <section class="feed-shell"><header><p class="eyebrow"><%= @space == "main" ? "Official updates" : "Member community" %></p><h1><%= @space.titleize %></h1></header>
    <% if authenticated? && @site.content_live? && ((@space == "main" && (Current.user.owner? || Current.user.admin? || Current.user.helper?)) || @space == "general") %>
      <%= form_with model: @post, class: "composer" do |f| %><%= f.hidden_field :space, value: @space %><%= f.label :title, "Title (optional)" %><%= f.text_field :title %><%= f.label :body, "Write a post" %><%= f.text_area :body, required: true, rows: 4 %><%= f.label :files, "Photos or videos (optional)" %><%= f.file_field :files, multiple: true, accept: "image/*,video/*" %><% if @space == "general" %><%= f.label :visibility, "Who can see it?" %><%= f.select :visibility, [["Members only", "members_only"], ["Everyone", "everyone"]] %><% end %><%= f.submit "Publish", class: "button" %><% end %>
    <% end %>
    <% @posts.each do |post| %><article class="post-card"><header><span class="author"><%= image_tag post.user.profile_photo, class: "avatar", alt: "" if post.user.profile_photo.attached? %><strong><%= post.user.display_name %></strong></span><time datetime="<%= post.published_at.iso8601 %>"><%= post.published_at.to_fs(:long) %></time></header><%= tag.p("Pinned", class: "eyebrow") if post.pinned? %><% if post.title.present? %><h2><%= post.title %></h2><% end %><%= simple_format(post.body) %><section class="media-grid"><% post.media_assets.where.not(status: :hidden).with_attached_file.each do |asset| %><figure><% if asset.image? %><%= image_tag asset.rendition(:feed) %><% else %><%= video_tag url_for(asset.file), controls: true %><% end %><figcaption><%= asset.caption %></figcaption></figure><% end %></section><footer><%= pluralize(post.comments.visible.count, "comment") %> <%= render "moderation_reports/button", reportable: post if authenticated? && @site.content_live? %><% if authenticated? && @site.content_live? && post.main? && (Current.user.owner? || Current.user.admin?) %> · <%= form_with model: post, class: "inline-form" do |f| %><%= f.hidden_field :pinned, value: !post.pinned? %><%= f.submit(post.pinned? ? "Unpin" : "Pin", class: "text-button") %><% end %><% end %></footer><% if post.comments_enabled? %><section class="comments"><% post.comments.visible.each do |comment| %><p><strong><%= comment.user.display_name %></strong> <%= comment.body %> <%= render "moderation_reports/button", reportable: comment if authenticated? && @site.content_live? %></p><% end %><% if authenticated? && @site.content_live? %><%= form_with url: post_comments_path(post), class: "comment-form" do |f| %><%= f.text_field :body, name: "comment[body]", required: true, placeholder: "Leave a comment" %><%= f.submit "Reply" %><% end %><% end %></section><% end %></article><% end %>
    <% if @posts.empty? %><section class="empty-surface"><h2>No posts yet</h2><p><%= @space == "main" ? "Official updates will appear here." : "Members can use this space for questions, messages, and uploads." %></p></section><% end %>
  </section>
</main>
