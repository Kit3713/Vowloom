<% questionnaire = local_assigns[:questionnaire] || post.postable %>
<% response = if questionnaire.individual?
  questionnaire.responses.find_by(user: Current.user) || questionnaire.responses.build(user: Current.user)
elsif Current.user&.invitee&.household
  questionnaire.responses.find_by(household: Current.user.invitee.household) || questionnaire.responses.build(household: Current.user.invitee.household)
end %>
<section class="interactive-post questionnaire-post">
  <div class="interactive-post-heading"><span class="interactive-post-icon"><%= social_icon(:questions) %></span><div><p class="eyebrow">Interactive questionnaire</p><h2><%= questionnaire.title %></h2></div><span class="interactive-status <%= "is-open" if questionnaire.open_for_responses? %>"><%= questionnaire.open_for_responses? ? "Open" : questionnaire.status.humanize %></span></div>
  <%= simple_format(questionnaire.introduction) if questionnaire.introduction.present? %>
  <div class="interactive-meta"><span><strong><%= questionnaire.questions.reject(&:information?).count %></strong> questions</span><span><strong><%= questionnaire.responses.where.not(submitted_at: nil).count %></strong> responses</span><span><%= questionnaire.audience_summary %></span></div>

  <% if local_assigns.fetch(:interactive, true) && response && questionnaire.open_for_responses? && questionnaire.response_editable?(response) %>
    <% current_answers = response.answers.index_by(&:question_id).transform_values { |answer| answer.value.fetch("answer", nil) } %>
    <details class="inline-questionnaire" <%= "open" unless response.submitted_at? %>>
      <summary><span><%= response.submitted_at? ? "Review or change your answers" : "Answer now" %></span><span aria-hidden="true">→</span></summary>
      <%= form_with url: questionnaire_response_path(questionnaire), class: "inline-questionnaire-form", data: { questionnaire_form: true } do |f| %>
        <%= hidden_field_tag :return_to, feed_path(post.space, anchor: dom_id(post)) %>
        <% questionnaire.questions.each do |question| %>
          <% if question.information? %><section class="question-information"><%= simple_format(question.prompt) %></section><% else %>
            <% answer = response.answers.find { |entry| entry.question_id == question.id } %><% value = answer&.value&.fetch("answer", "") %><% initially_visible = question.visible_for?(current_answers) %><% field_options = { required: question.required, disabled: question.conditional? && !initially_visible, data: { questionnaire_question_input: question.id } } %>
            <section class="inline-question" data-questionnaire-question-id="<%= question.id %>"<% if question.conditional? %> data-questionnaire-conditional-question-id="<%= question.conditional_rule.fetch("question_id") %>" data-questionnaire-conditional-value="<%= question.conditional_rule.fetch("equals") %>"<% end %><%= " hidden" if question.conditional? && !initially_visible %>>
              <%= label_tag "answers_#{question.id}", question.prompt %>
              <% if question.file? %><%= file_field_tag "files[#{question.id}]", accept: "application/pdf,image/*,video/*", **field_options.merge(required: question.required && !answer&.file&.attached?) %>
              <% elsif question.person? %><%= select_tag "answers[#{question.id}]", options_for_select(questionnaire.site.invitees.order(:last_name, :first_name).map { |invitee| [invitee.full_name, invitee.id] }, value), **field_options.merge(include_blank: !question.required) %>
              <% elsif question.long_text? %><%= text_area_tag "answers[#{question.id}]", value, **field_options.merge(rows: 3) %>
              <% elsif question.single_choice? || question.dropdown? %><%= select_tag "answers[#{question.id}]", options_for_select(question.options, value), **field_options.merge(include_blank: !question.required) %>
              <% elsif question.multiple_choice? %><%= select_tag "answers[#{question.id}]", options_for_select(question.options, Array(value)), **field_options.merge(multiple: true) %>
              <% elsif question.yes_no? %><%= select_tag "answers[#{question.id}]", options_for_select([["Yes", "yes"], ["No", "no"]], value), **field_options.merge(include_blank: !question.required) %>
              <% elsif question.date? %><%= date_field_tag "answers[#{question.id}]", value, **field_options %>
              <% elsif question.time? %><%= time_field_tag "answers[#{question.id}]", value, **field_options %>
              <% elsif question.number? || question.rating? %><%= number_field_tag "answers[#{question.id}]", value, **field_options %>
              <% else %><%= text_field_tag "answers[#{question.id}]", value, **field_options %><% end %>
            </section>
          <% end %>
        <% end %>
        <div class="inline-questionnaire-actions"><span>Your answers are saved to your wedding profile.</span><%= f.submit(response.submitted_at? ? "Update answers" : "Submit answers", class: "button") %></div>
      <% end %>
    </details>
  <% elsif response&.submitted_at? %><div class="response-received"><span aria-hidden="true">✓</span><div><strong>Response received</strong><small>Your answers are saved.</small></div></div>
  <% elsif questionnaire.manageable_by?(Current.user) %><p class="interactive-empty">This post needs questions before guests can answer it.</p><% end %>
  <% if questionnaire.manageable_by?(Current.user) %><%= link_to "Edit questions and settings", questionnaire_path(questionnaire), class: "interactive-manage-link" %><% end %>
</section>
