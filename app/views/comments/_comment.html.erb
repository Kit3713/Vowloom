<article id="<%= dom_id(comment) %>" class="comment-item <%= "comment-reply" if comment.reply? %>">
  <div class="comment-avatar"><% if comment.user.profile_photo.attached? %><%= image_tag comment.user.profile_photo, class: "avatar", alt: "" %><% else %><span class="avatar avatar-fallback"><%= person_initials(comment.user) %></span><% end %></div>
  <div class="comment-content">
    <div class="comment-bubble">
      <header><strong><%= comment.user.display_name %></strong><time datetime="<%= comment.created_at.iso8601 %>" title="<%= comment.created_at.to_fs(:long) %>"><%= time_ago_in_words(comment.created_at) %></time></header>
      <%= simple_format(comment.body) if comment.body.present? %>
      <% assets = comment.media_assets.where.not(status: :hidden).with_attached_file %>
      <% if assets.any? %><section class="comment-media <%= "comment-media-single" if assets.one? %>"><% assets.each do |asset| %><figure><% if asset.image? %><%= image_tag asset.rendition(:feed), alt: asset.caption.presence || "Photo shared by #{comment.user.display_name}" %><% else %><%= video_tag url_for(asset.file), controls: true, preload: "metadata" %><% end %></figure><% end %></section><% end %>
    </div>
    <footer class="comment-actions"><time><%= comment.created_at.strftime("%-I:%M %p") %></time><% if local_assigns.fetch(:interactive, true) && authenticated? && current_site.content_live? && !comment.reply? %><details class="reply-composer"><summary>Reply</summary><%= render "comments/form", post: comment.post, parent: comment %></details><% end %><%= render "moderation_reports/button", reportable: comment if local_assigns.fetch(:interactive, true) && authenticated? && current_site.content_live? %></footer>
    <% unless comment.reply? %><div id="<%= dom_id(comment, :replies) %>" class="comment-replies"><%= render partial: "comments/comment", collection: comment.replies, as: :comment %></div><% end %>
  </div>
</article>
