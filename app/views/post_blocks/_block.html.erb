<% return unless block.available_to?(Current.user) || block.post.manageable_by?(Current.user) %>
<section class="planning-block planning-block-<%= block.kind.dasherize %>" id="<%= dom_id(block) %>">
  <header class="planning-block-heading"><span class="planning-block-kind"><%= block.kind.humanize %></span><% if block.closes_at %><time datetime="<%= block.closes_at.iso8601 %>">Closes <%= block.closes_at.to_fs(:long) %></time><% end %></header>

  <% if block.text? %>
    <% if block.title.present? %><h3><%= block.title %></h3><% end %><div class="post-body"><%= simple_format(block.body) %></div>
  <% elsif block.media? %>
    <% if block.title.present? %><p class="media-element-caption"><%= block.title %></p><% end %><section class="media-grid post-media-grid"><% block.media_assets.where.not(status: :hidden).with_attached_file.each do |asset| %><figure><% if asset.image? %><%= image_tag asset.rendition(:feed) %><% else %><%= video_tag url_for(asset.file), controls: true, preload: "metadata" %><% end %></figure><% end %></section>
  <% elsif block.note? %>
    <% if block.title.present? %><h3><%= block.title %></h3><% end %>
    <% if block.contributable_by?(Current.user) %><%= form_with model: [block.post, block], class: "sticky-note-form" do |f| %><%= f.hidden_field :lock_version %><%= f.text_area :body, rows: 5, maxlength: 10_000, aria: { label: block.title.presence || "Shared note" } %><div class="sticky-note-footer"><span>Collaborative note · updated <%= time_ago_in_words(block.updated_at) %> ago</span><%= f.submit "Save note", class: "button" %></div><% end %><% else %><div class="sticky-note-body"><%= simple_format(block.body) %></div><% end %>
  <% elsif block.sheet? %>
    <% if block.title.present? %><h3><%= block.title %></h3><% end %><%= simple_format(block.body) if block.body.present? %>
    <%= form_with model: [block.post, block], class: "sticky-sheet-form", data: { sticky_sheet: true } do |f| %><%= f.hidden_field :lock_version %><%= f.hidden_field :grid_json, value: block.grid.to_json, data: { sheet_json: true } %><div class="sticky-sheet-scroll"><table><tbody data-sheet-body><% block.grid.each do |row| %><tr><% row.each do |cell| %><td><input type="text" value="<%= cell %>" maxlength="500" <%= "disabled" unless block.contributable_by?(Current.user) %> aria-label="Spreadsheet cell"></td><% end %></tr><% end %></tbody></table></div><% if block.contributable_by?(Current.user) %><div class="sticky-note-footer"><span><button type="button" class="text-button" data-sheet-add-row>Add row</button> · <button type="button" class="text-button" data-sheet-add-column>Add column</button></span><%= f.submit "Save sheet", class: "button" %></div><% end %><% end %>
  <% elsif block.list? %>
    <% if block.title.present? %><h3><%= block.title %></h3><% end %><%= simple_format(block.body) if block.body.present? %>
    <%= form_with model: [block.post, block], class: "sticky-list-form", data: { sticky_list: true } do |f| %><%= f.hidden_field :lock_version %><%= f.hidden_field :items_json, value: block.list_items.to_json, data: { list_json: true } %><div class="sticky-list-items" data-list-items><% block.list_items.each do |item| %><label class="sticky-list-item" data-list-id="<%= item["id"] %>"><input type="checkbox" <%= "checked" if item["done"] %> <%= "disabled" unless block.contributable_by?(Current.user) %>><input type="text" value="<%= item["text"] %>" maxlength="500" <%= "disabled" unless block.contributable_by?(Current.user) %> aria-label="List item"><% if item["updated_by"].present? %><small><%= item["updated_by"] %></small><% end %></label><% end %></div><% if block.contributable_by?(Current.user) %><div class="sticky-list-add"><input type="text" data-list-new placeholder="Add an item…"><button type="button" class="button button-secondary" data-list-add>Add</button></div><div class="sticky-note-footer"><span>Collaborative list</span><%= f.submit "Save list", class: "button" %></div><% end %><% end %>
  <% elsif block.questionnaire? && block.blockable.is_a?(Questionnaire) %>
    <%= render "feeds/questionnaire_post", post: block.post, questionnaire: block.blockable, interactive: block.interactive? %>
  <% elsif block.event_rsvp? && block.blockable.is_a?(Event) %>
    <% event = block.blockable %><div class="event-block"><div class="event-block-date"><strong><%= event.starts_at&.strftime("%b") || "TBA" %></strong><span><%= event.starts_at&.day || "—" %></span></div><div><h3><%= block.title.presence || event.title %></h3><p><%= event.starts_at&.to_fs(:long) || "Time to be announced" %><%= " · #{event.location_name}" if event.location_name.present? %></p><%= simple_format(block.body.presence || event.description) %></div></div>
    <% invitation = Current.user&.invitee&.event_invitations&.find_by(event:) %>
    <% if block.interactive? && invitation && event.rsvp_open? %><%= form_with url: event_rsvp_path(event), scope: :rsvp, method: :patch, class: "block-response-form event-rsvp-inline" do |f| %><%= f.label :rsvp_status, "Will you attend?" %><%= f.select :rsvp_status, [["Awaiting response", "pending"], ["Attending", "attending"], ["Declined", "declined"]], selected: invitation.rsvp_status %><%= f.submit "Save RSVP", class: "button" %><% end %><% else %><%= link_to "Open event details", event_path(event), class: "button button-secondary" %><% end %>
  <% elsif block.checklist? || block.signup? %>
    <% response = block.responses.find_by(user: Current.user) %><% selected = Array(response&.payload&.fetch("selections", [])) %><% counts = block.response_counts %>
    <% if block.title.present? %><h3><%= block.title %></h3><% end %><%= simple_format(block.body) if block.body.present? %>
    <%= form_with url: post_block_response_path(block), method: :patch, scope: :post_block_response, class: "block-response-form" do |f| %>
      <fieldset><legend class="sr-only"><%= block.title.presence || block.kind.humanize %></legend><% block.options.each do |option| %><label class="block-option"><%= block.signup? ? radio_button_tag("post_block_response[selections][]", option, selected.include?(option), disabled: !block.response_editable?(response)) : check_box_tag("post_block_response[selections][]", option, selected.include?(option), disabled: !block.response_editable?(response)) %><span><strong><%= option %></strong><% if block.results_visible_to?(Current.user) %><small><%= pluralize(counts[option], block.signup? ? "person" : "selection") %><%= " · #{[block.capacity - counts[option], 0].max} spots left" if block.signup? && block.capacity %></small><% end %></span></label><% end %></fieldset>
      <% if block.response_editable?(response) %><%= f.submit(response ? "Update response" : "Save response", class: "button") %><% elsif response %><p class="response-received"><strong>Response saved</strong></p><% end %>
    <% end %>
  <% elsif block.file_resource? %>
    <% if block.title.present? %><h3><%= block.title %></h3><% end %><%= simple_format(block.body) if block.body.present? %><div class="resource-files"><% block.files.each do |file| %><%= link_to rails_blob_path(file, disposition: "attachment"), class: "resource-file" do %><%= social_icon(:announcement) %><span><strong><%= file.filename %></strong><small><%= number_to_human_size(file.byte_size) %></small></span><% end %><% end %></div>
  <% elsif block.location? %>
    <% if block.title.present? %><h3><%= block.title %></h3><% end %><%= simple_format(block.body) if block.body.present? %><address><%= simple_format(block.settings["address"]) %></address><%= link_to "Open map", block.settings["map_url"], target: "_blank", rel: "noopener", class: "button button-secondary" if block.settings["map_url"].present? %>
  <% elsif block.album? && block.blockable.is_a?(Album) %>
    <% album = block.blockable %><h3><%= block.title.presence || album.title %></h3><%= simple_format(block.body.presence || album.description) %><section class="media-grid block-album-grid"><% album.media_assets.approved.with_attached_file.first(6).each do |asset| %><figure><% if asset.image? %><%= image_tag asset.rendition(:thumbnail) %><% else %><%= video_tag url_for(asset.file), controls: true %><% end %></figure><% end %></section><%= link_to "Open gallery", gallery_path(anchor: dom_id(album)), class: "interactive-manage-link" %>
  <% else %>
    <% if block.title.present? %><h3><%= block.title %></h3><% end %><%= simple_format(block.body) if block.body.present? %>
  <% end %>

  <% if block.post.manageable_by?(Current.user) %><footer class="planning-block-admin"><%= button_to "Remove block", post_post_block_path(block.post, block), method: :delete, class: "text-button", form: { data: { turbo_confirm: "Remove this block and its responses?" } } %></footer><% end %>
</section>
