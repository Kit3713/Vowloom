<% resource_options = [] %>
<% post.site.questionnaires.order(:title).each { |item| resource_options << ["Questionnaire — #{item.title}", "Questionnaire:#{item.id}"] if item.available_to?(Current.user) || item.manageable_by?(Current.user) } %>
<% post.site.events.order(:starts_at).each { |item| resource_options << ["Event / RSVP — #{item.title}", "Event:#{item.id}"] if item.visible_to?(Current.user) } %>
<% post.site.albums.order(:title).each { |item| resource_options << ["Album — #{item.title}", "Album:#{item.id}"] } %>
<details class="block-studio">
  <summary><span class="create-icon"><%= social_icon(:plus) %></span><span><strong>Add planning block</strong><small>Combine forms, RSVPs, sign-ups, files, locations, and more.</small></span></summary>
  <%= form_with url: post_post_blocks_path(post), scope: :post_block, class: "block-builder", multipart: true, data: { block_builder: true } do |f| %>
    <% type_labels = { "text" => "Text", "media" => "Photo or video", "note" => "Sticky note", "sheet" => "Spreadsheet sticky note", "list" => "List sticky note", "questionnaire" => "Questionnaire or poll", "event_rsvp" => "Event and RSVP", "checklist" => "Personal checklist", "signup" => "Shared sign-up", "file_resource" => "Downloadable files", "location" => "Location and map", "album" => "Gallery album" } %>
    <div class="field"><%= f.label :kind, "Element type" %><%= f.select :kind, PostBlock::TYPES.map { |type| [type_labels.fetch(type), type] }, {}, data: { block_kind: true } %></div>
    <div class="field"><%= f.label :title, "Heading (optional)" %><%= f.text_field :title %></div>
    <div class="field" data-block-fields="text note checklist signup file_resource location"><%= f.label :body, "Details" %><%= f.text_area :body, rows: 3 %></div>
    <div class="field" data-block-fields="questionnaire event_rsvp album"><%= f.label :resource_key, "Existing wedding resource" %><%= f.select :resource_key, resource_options, include_blank: "Choose a questionnaire, event, or album" %></div>
    <div class="field" data-block-fields="list checklist signup"><%= f.label :options_text, "Starting items—one per line" %><%= f.text_area :options_text, rows: 5, placeholder: "Airport pickup\nVenue setup\nBring dessert" %></div>
    <div class="field" data-block-fields="signup"><%= f.label :capacity, "Spaces available per choice (optional)" %><%= f.number_field :capacity, min: 1 %></div>
    <div class="field" data-block-fields="media"><%= f.label :files, "Photos or videos" %><%= f.file_field :files, multiple: true, accept: "image/*,video/*" %></div>
    <div class="field" data-block-fields="file_resource"><%= f.label :files, "Downloadable files" %><%= f.file_field :files, multiple: true, accept: ".pdf,.txt,.csv,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.odt,.ods" %><small>Office documents are preserved as downloads; they are never executed by Vowloom.</small></div>
    <div class="field" data-block-fields="location"><%= f.label :address %><%= f.text_area :address, rows: 2 %><%= f.label :map_url, "Map link" %><%= f.url_field :map_url %></div>
    <label class="setup-toggle" data-block-fields="note sheet list questionnaire event_rsvp checklist signup"><%= f.check_box :interactive %><span><strong>Interactive element</strong><small>Allow permitted members to edit or respond. Leave off to make this element display-only.</small></span></label>
    <div class="block-rule-grid" data-block-fields="note sheet list questionnaire event_rsvp checklist signup file_resource location album">
      <div class="field"><%= f.label :audience %><%= f.select :audience, [["Members", "members"], ["Staff only", "staff"]] %></div>
      <div class="field"><%= f.label :closes_at, "Deadline (optional)" %><%= f.datetime_local_field :closes_at %></div>
      <div class="field"><%= f.label :response_edit_policy, "Response changes" %><%= f.select :response_edit_policy, [["Editable until deadline", "editable"], ["Lock after submission", "locked"]] %></div>
      <div class="field"><%= f.label :results_visibility %><%= f.select :results_visibility, [["Participants and staff", "participants"], ["All members", "members"], ["Staff only", "staff"]] %></div>
    </div>
    <%= f.submit "Add block", class: "button" %>
  <% end %>
</details>
