<main class="community-page" style="--accent: <%= @group.site.accent_color %>">
  <header class="community-header">
    <%= link_to @group.site.name, community_path, class: "brand" %>
    <%= link_to "All groups", groups_path %>
  </header>

  <section class="feed-shell">
    <p class="eyebrow"><%= @group.participation.humanize %> group</p>
    <h1><%= @group.name %></h1>
    <%= simple_format(@group.description) %>
    <p><%= link_to "Open live chat", group_chat_path(@group), class: "button button-secondary" if @conversation %></p>

    <% if @group.event || @group_questionnaires.any? || @pinned_resources.any? || @resource_options %>
      <section class="post-card group-resources" aria-label="Group planning resources">
        <h2>Planning resources</h2>
        <p class="muted">Important plans, forms, and shared media for this group.</p>

        <% if @group.event && @group.event.visible_to?(Current.user) %>
          <article class="management-row">
            <div><strong>Event</strong><br><%= @group.event.title %><%= " · #{@group.event.starts_at.to_fs(:long)}" if @group.event.starts_at %></div>
            <%= link_to "Open event", @group.event, class: "button button-secondary" %>
          </article>
        <% end %>

        <% @group_questionnaires.each do |questionnaire| %>
          <article class="management-row">
            <div><strong>Questionnaire</strong><br><%= questionnaire.title %><%= " · closes #{questionnaire.closes_at.to_fs(:long)}" if questionnaire.closes_at %></div>
            <%= link_to "Open questionnaire", questionnaire, class: "button button-secondary" %>
          </article>
        <% end %>

        <% @pinned_resources.each do |resource| %>
          <% case resource.resourceable %>
          <% when Event %>
            <article class="management-row">
              <div><strong>Pinned event</strong><br><%= resource.resourceable.title %><%= " · #{resource.resourceable.starts_at.to_fs(:long)}" if resource.resourceable.starts_at %></div>
              <%= link_to "Open event", resource.resourceable, class: "button button-secondary" %>
              <%= button_to "Unpin", group_group_resource_path(@group, resource), method: :delete, class: "text-button" if @available_members %>
            </article>
          <% when Questionnaire %>
            <article class="management-row">
              <div><strong>Pinned questionnaire</strong><br><%= resource.resourceable.title %></div>
              <%= link_to "Open questionnaire", resource.resourceable, class: "button button-secondary" %>
              <%= button_to "Unpin", group_group_resource_path(@group, resource), method: :delete, class: "text-button" if @available_members %>
            </article>
          <% when Album %>
            <article class="management-row">
              <div><strong>Pinned album</strong><br><%= resource.resourceable.title %></div>
              <%= link_to "Open album", gallery_path(anchor: dom_id(resource.resourceable)), class: "button button-secondary" %>
              <%= button_to "Unpin", group_group_resource_path(@group, resource), method: :delete, class: "text-button" if @available_members %>
            </article>
          <% when MediaAsset %>
            <article class="management-row group-media-resource">
              <div>
                <strong>Pinned photo or video</strong><br>
                <% if resource.resourceable.image? %>
                  <%= image_tag resource.resourceable.rendition(:thumbnail), alt: resource.resourceable.caption.presence || "Pinned wedding photo" %>
                <% else %>
                  <%= video_tag url_for(resource.resourceable.file), controls: true %>
                <% end %>
                <p><%= resource.resourceable.caption.presence || resource.resourceable.file.filename.to_s %></p>
              </div>
              <div>
                <%= link_to "Download web copy", download_media_asset_path(resource.resourceable), class: "button button-secondary" if authenticated? %>
                <%= button_to "Unpin", group_group_resource_path(@group, resource), method: :delete, class: "text-button" if @available_members %>
              </div>
            </article>
          <% end %>
        <% end %>

        <% if @resource_options %>
          <%= form_with url: group_group_resources_path(@group), scope: :group_resource, class: "inline-form" do |f| %>
            <%= f.label :resource_key, "Pin an existing resource" %>
            <%= f.select :resource_key, @resource_options, include_blank: "Choose an event, questionnaire, album, or media" %>
            <%= f.submit "Pin", class: "button button-secondary" %>
          <% end %>
        <% end %>
      </section>
    <% end %>

    <% if @available_members %>
      <section class="post-card">
        <h2>Group members</h2>
        <%= form_with url: group_group_memberships_path(@group), class: "inline-form" do |f| %>
          <%= f.label :user_id, "Add a member" %>
          <%= f.select :user_id, @available_members.reject { |member| @group.members.include?(member) }.map { |member| [member.display_name, member.id] }, include_blank: "Choose a member" %>
          <%= f.submit "Add", class: "button button-secondary" %>
        <% end %>
        <% @group.group_memberships.includes(:user).each do |membership| %>
          <p>
            <%= membership.user.display_name %>
            <%= button_to "Remove", group_group_membership_path(@group, membership), method: :delete, class: "text-button" unless membership.user == @group.created_by %>
          </p>
        <% end %>
      </section>
    <% end %>

    <section class="post-card">
      <h2>Tasks</h2>
      <% if @available_members && @group.site.content_live? %>
        <%= form_with model: [@group, @task], class: "stack" do |f| %>
          <%= f.label :title %>
          <%= f.text_field :title, required: true %>
          <%= f.label :description %>
          <%= f.text_area :description, rows: 2 %>
          <%= f.label :assigned_user_id, "Assign to (optional)" %>
          <%= f.select :assigned_user_id, @group.members.map { |member| [member.display_name, member.id] }, include_blank: "Unassigned" %>
          <%= f.label :due_on %>
          <%= f.date_field :due_on %>
          <%= f.submit "Add task", class: "button button-secondary" %>
        <% end %>
      <% end %>
      <% @tasks.each do |task| %>
        <article class="management-row">
          <div>
            <strong><%= task.complete? ? "✓" : "○" %> <%= task.title %></strong><br>
            <%= task.assigned_user&.display_name || "Unassigned" %>
            <%= " · due #{task.due_on.to_fs(:long)}" if task.due_on %>
          </div>
          <% if @available_members && @group.site.content_live? %>
            <%= button_to(task.complete? ? "Reopen" : "Complete", group_task_path(@group, task), method: :patch, class: "button button-secondary") %>
          <% end %>
        </article>
        <section class="comments">
          <% task.task_comments.each do |comment| %>
            <p><strong><%= comment.user.display_name %></strong> <%= comment.body %></p>
          <% end %>
          <% if authenticated? && @group.site.content_live? %>
            <%= form_with url: group_task_task_comments_path(@group, task), class: "comment-form" do |f| %>
              <%= f.text_field :body, name: "task_comment[body]", required: true, placeholder: "Comment on this task" %>
              <%= f.submit "Reply" %>
            <% end %>
          <% end %>
        </section>
      <% end %>
      <% if @tasks.empty? %>
        <p>No tasks yet.</p>
      <% end %>
    </section>

    <% if authenticated? && @group.site.content_live? && (@group.discussion? || Current.user.owner? || Current.user.admin? || Current.user.helper?) %>
      <%= form_with model: @post, class: "composer" do |f| %>
        <%= f.hidden_field :space, value: "group_space" %>
        <%= f.hidden_field :group_id, value: @group.id %>
        <%= f.label :body, "Write a post" %>
        <%= f.text_area :body, required: true, rows: 3 %>
        <%= f.label :files, "Photos or videos (optional)" %>
        <%= f.file_field :files, multiple: true, accept: "image/*,video/*" %>
        <%= f.submit "Publish", class: "button" %>
      <% end %>
    <% end %>

    <% @posts.each do |post| %>
      <article class="post-card">
        <header>
          <span class="author">
            <%= image_tag post.user.profile_photo, class: "avatar", alt: "" if post.user.profile_photo.attached? %>
            <strong><%= post.user.display_name %></strong>
          </span>
          <time datetime="<%= post.published_at.iso8601 %>"><%= post.published_at.to_fs(:long) %></time>
        </header>
        <%= simple_format(post.body) %>
        <section class="media-grid">
          <% post.media_assets.where(comment_id: nil).where.not(status: :hidden).with_attached_file.each do |asset| %>
            <figure>
              <% if asset.image? %>
                <%= image_tag asset.rendition(:feed) %>
              <% else %>
                <%= video_tag url_for(asset.file), controls: true %>
              <% end %>
              <figcaption><%= asset.caption %></figcaption>
            </figure>
          <% end %>
        </section>
        <footer>
          <%= pluralize(post.comments.visible.count, "comment") %>
          <%= render "moderation_reports/button", reportable: post if authenticated? && @group.site.content_live? %>
        </footer>
        <% if post.comments_enabled? %><%= render "comments/thread", post: post %><% end %>
      </article>
    <% end %>
  </section>
</main>
