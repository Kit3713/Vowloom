<main class="community-page" style="--accent: <%= @site.accent_color %>">
  <section class="feed-shell">
    <header class="page-intro"><div><p class="eyebrow">Coordination spaces</p><h1>Groups</h1><p>Focused places for travel, wedding parties, family plans, and useful conversations.</p></div></header>
    <% if authenticated? && (Current.user.owner? || Current.user.admin? || Current.user.helper?) && @site.content_live? %>
      <details class="create-panel" <%= "open" if @group.errors.any? %>><summary><span class="create-icon"><%= social_icon(:plus) %></span><span>Create a group</span></summary><%= form_with model: @group, class: "composer" do |f| %><%= f.label :name %><%= f.text_field :name, required: true %><%= f.label :description %><%= f.text_area :description %><%= f.label :event_id, "Related event (optional)" %><%= f.select :event_id, @available_events.map { |event| [event.title, event.id] }, include_blank: "No related event" %><%= f.label :visibility %><%= f.select :visibility, [["Open — every member can join", "site_wide"], ["Invite only", "private_group"]] %><%= f.submit "Create group", class: "button" %><% end %></details>
    <% end %>
    <section class="collection-grid"><% @groups.each do |group| %><%= link_to group, class: "collection-card" do %><p class="eyebrow"><%= group.private_group? ? "Invite-only group" : "Open group" %></p><h2><%= group.name %></h2><p><%= truncate(group.description, length: 130) %></p><footer>Planning, posts & conversation<%= " · #{group.event.title}" if group.event %> →</footer><% end %><% end %></section>
    <% if @groups.empty? %><section class="empty-surface"><h2>No groups yet</h2><p>Staff can create a focused space when the wedding needs one.</p></section><% end %>
  </section>
</main>
