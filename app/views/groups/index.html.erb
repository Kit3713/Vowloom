<main class="community-page" style="--accent: <%= @site.accent_color %>"><header class="community-header"><%= link_to @site.name, community_path, class: "brand" %><nav><%= link_to "Main", feed_path("main") %><%= link_to "General", feed_path("general") %><%= link_to "Groups", groups_path %></nav></header><section class="feed-shell"><p class="eyebrow">Coordination spaces</p><h1>Groups</h1><% if authenticated? && (Current.user.owner? || Current.user.admin? || Current.user.helper?) && @site.content_live? %><%= form_with model: @group, class: "composer" do |f| %><%= f.label :name %><%= f.text_field :name, required: true %><%= f.label :description %><%= f.text_area :description %><%= f.label :event_id, "Related event (optional)" %><%= f.select :event_id, @available_events.map { |event| [event.title, event.id] }, include_blank: "No related event" %><%= f.label :visibility %><%= f.select :visibility, [["Site-wide", "site_wide"], ["Private", "private_group"]] %><%= f.label :participation %><%= f.select :participation, [["Information — staff post", "information"], ["Discussion — members post", "discussion"]] %><%= f.submit "Create group", class: "button" %><% end %><% end %><% @groups.each do |group| %><article class="post-card"><h2><%= link_to group.name, group %></h2><p><%= group.description %></p><p><%= group.visibility.humanize %> · <%= group.participation.humanize %><%= " · #{group.event.title}" if group.event %></p></article><% end %></section></main>
