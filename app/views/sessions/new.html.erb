<%= form_with url: session_path do |form| %>
  <%= form.text_field :login_identifier, required: true, autofocus: true, autocomplete: "username", placeholder: "Sign-in name", value: params[:login_identifier] %><br>
  <%= form.password_field :password, required: true, autocomplete: "current-password", placeholder: "Enter your password", maxlength: 72 %><br>
  <%= form.submit "Sign in" %>
<% end %>
<br>

<% if EmailDeliveryConfiguration.configured? %>
  <%= link_to "Forgot password?", new_password_path %>
<% else %>
  <p class="setup-note">Email password recovery is not configured on this server.</p>
<% end %>
